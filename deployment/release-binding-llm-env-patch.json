    "value": {"key": "LLM_PROVIDER", "value": "gemini"}
  },
  {
    "op": "add",
    "path": "/spec/workloadOverrides/container/env/-",
    "value": {"key": "LLM_MODEL", "value": "gemini-3-flash-preview"}
